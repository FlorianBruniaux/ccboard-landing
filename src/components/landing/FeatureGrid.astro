---
// Features section: 3 workflow cards + 9 tabs detail (collapsible)

const workflows = [
  { icon: '💰', title: 'Cost Tracking', desc: 'Budget alerts, 30-day forecasting, billing blocks', tabs: ['Costs', 'Analytics', 'History'] },
  { icon: '🔍', title: 'Session Monitoring', desc: 'Live processes (CPU/RAM/Tokens), search, conversation replay', tabs: ['Sessions', 'Dashboard', 'Search'] },
  { icon: '⚙️', title: 'Config Management', desc: '3-level merge, hooks, agents, MCP servers', tabs: ['Config', 'Hooks', 'Agents', 'MCP'] },
  { icon: '🔒', title: 'Security Audit', desc: 'Cross-session violations feed, destructive command detection, credential exposure alerts', tabs: ['Activity'] },
]

const features = [
  { icon: '📊', title: 'Dashboard', desc: 'Overview stats, model usage, MCP servers, 30-day activity heatmap (responsive), API usage estimation with plan budgets.' },
  { icon: '🔍', title: 'Sessions', desc: 'Browse all sessions with search, live Claude processes with CPU/RAM/Tokens, conversation replay with tool call visualization.' },
  { icon: '📖', title: 'Conversation Viewer', desc: 'Full JSONL replay with tool call visualization (grouped, collapsible), regex search with hit navigation, HTML export with syntax highlighting (40+ languages).' },
  { icon: '🔎', title: 'Search', desc: 'FTS5 full-text search across all sessions with search-as-you-type, detail pane (date, project, snippet), arrow-key navigation, and conversation jump.' },
  { icon: '⚙️', title: 'Config', desc: 'Cascading configuration editor (global/project/local) with 4-column diff view.' },
  { icon: '🔗', title: 'Hooks', desc: 'Event-based hook management with bash syntax highlighting and test mode.' },
  { icon: '🤖', title: 'Agents', desc: 'Browse agents, commands, and skills with frontmatter YAML parsing and invocation stats.' },
  { icon: '💰', title: 'Costs', desc: 'Budget quota gauge with 4-level alerts (Safe/Warning/Critical/Exceeded), MTD cost, monthly projection, billing blocks export.' },
  { icon: '🕐', title: 'History', desc: 'Full-text search across sessions with temporal patterns, filters, and CSV/JSON export.' },
  { icon: '🔌', title: 'MCP', desc: 'Server management with status detection and env vars display.' },
  { icon: '📈', title: 'Analytics', desc: 'Advanced analytics: responsive activity heatmap, trends, patterns, insights. Heatmap fills available space and adapts to terminal width.' },
  { icon: '🔒', title: 'Activity', desc: 'Security audit tab: per-session file/bash/network tool calls, cross-session violations feed sorted Critical→Warning→Info with remediation hints.' },
]
---

<section id="features" class="py-16 md:py-20">
  <div class="mx-auto max-w-content px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-12">
      Everything You Need to Monitor Claude Code
    </h2>

    <!-- 3 Workflow Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      {workflows.map((w) => (
        <div class="bg-background-secondary border border-border rounded-lg p-6 hover:border-accent hover:-translate-y-1 transition-all">
          <div class="text-3xl mb-3">{w.icon}</div>
          <h3 class="text-lg font-semibold text-text-primary mb-2">{w.title}</h3>
          <p class="text-sm text-text-secondary mb-3">{w.desc}</p>
          <div class="flex flex-wrap gap-1.5">
            {w.tabs.map((tab) => (
              <span class="text-xs px-2 py-0.5 rounded-full bg-background-tertiary text-accent font-medium">{tab}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- All 9 Tabs Detail (collapsible) -->
    <details class="border border-border rounded-lg">
      <summary class="cursor-pointer font-semibold text-accent p-4 hover:bg-background-secondary transition-colors text-center">
        View all 12 tabs in detail →
      </summary>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-4 pt-2">
        {features.map((f) => (
          <div class="bg-background border border-border rounded-lg p-4 hover:border-accent transition-colors">
            <div class="text-2xl mb-2">{f.icon}</div>
            <h3 class="text-base font-semibold text-text-primary mb-1">{f.title}</h3>
            <p class="text-sm text-text-secondary">{f.desc}</p>
          </div>
        ))}
      </div>
    </details>
  </div>
</section>
